include README.md README.zh-TW.md LICENSE CHANGELOG.md CONTRIBUTING.md SECURITY.md AGENTS.md
recursive-include src *.py *.md *.yaml
recursive-include tests *.py
recursive-include scripts *.py
recursive-include docs *.md
recursive-include examples *.py *.json *.md
recursive-include benchmarks *.json *.md
recursive-include integrations *.md
recursive-include .agents *.md *.py *.yaml
recursive-include .github *.yml *.md
global-exclude *.py[cod]
global-exclude __pycache__
